# Deployment template: install Node 22 and replace paths as needed.
# Keep the native engine in a separate unit; only the approved mirror is shared.
[Unit]
Description=Private Horizon browser gateway
After=network.target

[Service]
Type=simple
User=horizon
Group=horizon
WorkingDirectory=/srv/horizon/web/server
ExecStart=/usr/bin/node /srv/horizon/web/server/cli.mjs /etc/horizon/gateway.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
UMask=0077
StateDirectory=horizon-gateway
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/horizon-gateway
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
TasksMax=96
MemoryMax=512M
LimitNOFILE=1024
LimitCORE=0

[Install]
WantedBy=multi-user.target
